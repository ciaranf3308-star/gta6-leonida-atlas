{
  "name": "gta6-leonida-atlas",
  "version": "0.31.0",
  "packageManager": "pnpm@12.18.0",
  "private": false,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "VICEWIRE — spoiler-free, local-first GTA VI Leonida map. Fork of Leonida Atlas; the real GTADB in-game map, colour-graded, with everything off by default.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciaranf3308-star/gta6-leonida-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/ciaranf3308-star/gta6-leonida-atlas/issues"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/finalize-build.mjs",
    "preview": "ATLAS_BASE_PATH=/gta6-leonida-atlas/ vite preview --host 127.0.0.1 --port 4330",
    "start": "ATLAS_BASE_PATH=/gta6-leonida-atlas/ vite preview --host 127.0.0.1 --port 4330",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build:basemap": "node scripts/build-leonida-atlas-basemap.mjs",
    "build:clean": "bash scripts/build-from-clean.sh",
    "tiles:check": "python3 scripts/grade-tiles.py --check",
    "test:fork": "node scripts/test-fork.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "dexie": "4.4.7",
    "leaflet": "1.9.4",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "^6.2.6",
    "leaflet.markercluster": "2.0.0-beta.2",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "supercluster": "8.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10"
  }
}
